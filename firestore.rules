rules_version = '2';

// Bwriter back room — Firestore security rules.
// Identity comes from Firebase Auth (Google sign-in bridge in the app).
// The Editor in Chief is the account real.artistry@gmail.com.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isSuper() {
      return signedIn() && request.auth.token.email == 'real.artistry@gmail.com';
    }

    // Global registry: any signed-in user may read; only the Editor in
    // Chief creates entries (approval moves them here from the queue).
    // An author may update or remove their own entry.
    match /registry/{fileId} {
      allow read: if signedIn();
      allow create: if isSuper();
      allow update: if isSuper()
        || (signedIn() && resource.data.authorEmail == request.auth.token.email
            && request.resource.data.authorEmail == request.auth.token.email);
      allow delete: if isSuper()
        || (signedIn() && resource.data.authorEmail == request.auth.token.email);

      // The book's full text, stored under its registry entry. Readable by
      // any signed-in user when the book is public, and by its author and
      // the Editor in Chief always. Only the author (or the Editor in
      // Chief) may write it.
      match /content/{docId} {
        allow read: if isSuper()
          || (signedIn() && resource.data.authorEmail == request.auth.token.email)
          || (signedIn() && resource.data.isPublicInCommunity == true);
        allow write: if isSuper()
          || (signedIn() && request.resource.data.authorEmail == request.auth.token.email);
      }
    }

    // Registry approval queue: a synced book waits here until the Editor in
    // Chief approves it into the public registry. Only its author and the
    // Editor in Chief may see a pending entry; the Editor in Chief moves it
    // into /registry on approval or deletes it on rejection.
    match /registryPending/{fileId} {
      allow read: if isSuper()
        || (signedIn() && resource.data.authorEmail == request.auth.token.email);
      allow create: if signedIn()
        && request.resource.data.authorEmail == request.auth.token.email;
      allow update: if isSuper()
        || (signedIn() && resource.data.authorEmail == request.auth.token.email
            && request.resource.data.authorEmail == request.auth.token.email);
      allow delete: if isSuper()
        || (signedIn() && resource.data.authorEmail == request.auth.token.email);

      // The pending book's full text: only its author and the Editor in
      // Chief, until approval moves it under /registry.
      match /content/{docId} {
        allow read: if isSuper()
          || (signedIn() && resource.data.authorEmail == request.auth.token.email);
        allow write: if isSuper()
          || (signedIn() && request.resource.data.authorEmail == request.auth.token.email);
      }
    }

    // Suspension records: readable by signed-in users (the app checks its own
    // record at sign-in); only the Editor in Chief writes.
    match /suspended/{email} {
      allow read: if signedIn();
      allow write: if isSuper();
    }

    // In-app mail: a user reads mail addressed to them; the Editor in Chief
    // reads all. A user sends only under their own address; the studio
    // address is reserved to the Editor in Chief. Recipients may mark read.
    match /mail/{messageId} {
      allow read: if isSuper()
        || (signedIn() && resource.data.recipientEmail == request.auth.token.email);
      allow create: if signedIn()
        && (request.resource.data.senderEmail == request.auth.token.email
            || (isSuper() && request.resource.data.senderEmail == 'author.studio@bwriter.io'));
      allow update: if isSuper()
        || (signedIn() && resource.data.recipientEmail == request.auth.token.email);
      allow delete: if isSuper();
    }

    // A writer's own cloud book copies: only the owner (and the Editor in
    // Chief) may read or write them. Document id is "{email}_{manuscriptId}".
    match /cloudBooks/{docId} {
      allow read: if isSuper()
        || (signedIn() && resource.data.ownerEmail == request.auth.token.email);
      allow create: if signedIn()
        && request.resource.data.ownerEmail == request.auth.token.email;
      allow update: if isSuper()
        || (signedIn() && resource.data.ownerEmail == request.auth.token.email
            && request.resource.data.ownerEmail == request.auth.token.email);
      allow delete: if isSuper()
        || (signedIn() && resource.data.ownerEmail == request.auth.token.email);
    }

    // Version history snapshots for a manuscript.
    match /versionSnapshots/{docId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isSuper();
    }
  }
}
