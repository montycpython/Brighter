<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <exclude domain="sharedpref" path="bwriter_user_prefs.xml" />
        <exclude domain="sharedpref" path="author_keys.xml" />
        <exclude domain="sharedpref" path="bwriter_ads.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <exclude domain="sharedpref" path="bwriter_user_prefs.xml" />
        <exclude domain="sharedpref" path="author_keys.xml" />
        <exclude domain="sharedpref" path="bwriter_ads.xml" />
    </device-transfer>
</data-extraction-rules>
